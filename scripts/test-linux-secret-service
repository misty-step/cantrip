#!/usr/bin/env bash
# Run the Secret Service round-trip tests against a real gnome-keyring-daemon
# on a private, throwaway D-Bus session (never the user's real keyring).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
cargo test -p cantrip --no-run --quiet
home="$(mktemp -d)"
trap 'rm -rf "$home"' EXIT
# Keyrings live under XDG_DATA_HOME; keep HOME so cargo/rustup stay put.
export XDG_DATA_HOME="$home/data" XDG_RUNTIME_DIR="$home/run"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
# 1. Unreachable secret store: an error, never "no key".
DBUS_SESSION_BUS_ADDRESS="unix:path=$home/no-such-bus" \
  cargo test -p cantrip secrets::tests::missing_service -- --ignored --nocapture
# 2. A real, unlocked keyring: write, read, replace, delete.
dbus-run-session -- bash -c '
  printf "cantrip-test-password" | gnome-keyring-daemon --unlock --components=secrets >/dev/null
  sleep 0.5
  cargo test -p cantrip secrets::tests::round_trip -- --ignored --nocapture
'
