#!/usr/bin/env bash
# Repository-owned clone-to-green command.
#
# Runs the same gates CI enforces, in order, and stops at the first red
# gate:
#   1. Landmark-visible commit subjects
#   2. cargo fmt --all --check
#   3. cargo clippy --workspace --locked --all-targets -- -D warnings
#   4. cargo test --workspace --locked
#   5. Offline evaluation example tests
#   6. Installer and release safety tests
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "── check: Landmark-visible commit subjects"
./scripts/check-commit-subjects --self-test
./scripts/check-commit-subjects

echo "── check: cargo fmt --all --check"
cargo fmt --all --check

echo "── check: cargo clippy --workspace --locked --all-targets -- -D warnings"
cargo clippy --workspace --locked --all-targets -- -D warnings

echo "── check: cargo test --workspace --locked"
cargo test --workspace --locked

echo "── check: offline evaluation example"
cargo test --locked --package cantrip --example eval

echo "── check: Omarchy installer"
python3 -m unittest discover -s integrations/omarchy -p 'test_*.py'

echo "── check: release artifact and installer"
python3 -m unittest discover -s tests -p 'test_release_*.py'

echo "── check: source installer"
python3 -m unittest discover -s tests -p 'test_install_from_source.py'

echo "── check: website deploy smoke"
python3 -m unittest discover -s tests -p 'test_verify_site.py'
