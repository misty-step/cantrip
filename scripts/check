#!/usr/bin/env bash
# Repository-owned clone-to-green command.
#
# Runs the same gates CI enforces, in order, and stops at the first red
# gate:
#   1. cargo fmt --check
#   2. cargo clippy --locked --all-targets -- -D warnings
#   3. cargo test --locked
#   4. Offline evaluation example tests
#   5. Installer and release safety tests
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "── check: cargo fmt --check"
cargo fmt --check

echo "── check: cargo clippy --locked --all-targets -- -D warnings"
cargo clippy --locked --all-targets -- -D warnings

echo "── check: cargo test --locked"
cargo test --locked

echo "── check: offline evaluation example"
cargo test --locked --example eval

echo "── check: Omarchy installer"
python3 -m unittest discover -s integrations/omarchy -p 'test_*.py'

echo "── check: release artifact and installer"
python3 -m unittest discover -s tests -p 'test_release_*.py'