#!/usr/bin/env bash
# Repository-owned clone-to-green command. CI runs the two independent tiers in
# parallel; no argument runs their union locally and stops at the first red gate.
#
#   rust       fmt, clippy (Linux, plus a macOS type-check of the macOS
#              platform module), unit/integration tests
#   contracts  release / installer / website script tests
#
# Live desktop tests (X11 + AT-SPI, PipeWire, Secret Service) are #[ignore]d;
# run them on a real session with:
#   DISPLAY=:0 cargo test -p cantrip -- --ignored --test-threads=1
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

tier="${1-all}"
if [[ $# -gt 1 || ! "$tier" =~ ^(all|rust|contracts)$ ]]; then
  echo "Usage: scripts/check [all|rust|contracts]" >&2
  exit 2
fi

if [[ "$tier" != contracts ]]; then
  echo "── check: cargo fmt --all --check"
  cargo fmt --all --check

  echo "── check: cargo clippy --workspace --all-targets -- -D warnings (Linux)"
  cargo clippy --workspace --locked --all-targets -- -D warnings

  # rust-toolchain.toml installs the target; no Apple SDK is needed to type-check.
  echo "── check: cargo clippy -p cantrip --target aarch64-apple-darwin -- -D warnings (macOS, type-checked)"
  cargo clippy -p cantrip --locked --target aarch64-apple-darwin -- -D warnings

  echo "── check: cargo test --workspace"
  cargo test --workspace --locked
fi

if [[ "$tier" != rust ]]; then
  echo "── check: release artifact and installer"
  python3 -m unittest discover -s tests -p 'test_release_*.py'

  echo "── check: source installer"
  python3 -m unittest discover -s tests -p 'test_install_from_source.py'

  echo "── check: website deploy smoke"
  python3 -m unittest discover -s tests -p 'test_verify_site.py'
fi
