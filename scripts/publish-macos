#!/usr/bin/env python3
"""Attach production macOS assets to an existing released tag, using only this Mac's login Keychain."""

import argparse
import json
import os
from pathlib import Path
import platform
import re
import runpy
import shutil
import sys
import tempfile
import tomllib


ROOT = Path(__file__).resolve().parent.parent
PACKAGE = runpy.run_path(str(ROOT / "scripts" / "package-macos"))
RELEASE = PACKAGE["RELEASE"]
ReleaseError = PACKAGE["ReleaseError"]
run = PACKAGE["run"]
REPOSITORY = "misty-step/cantrip"


def released_source(tag):
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", tag):
        raise ReleaseError("--tag must be a released numeric vMAJOR.MINOR.PATCH tag")
    revision = RELEASE["git"](ROOT, "rev-parse", "--verify", f"refs/tags/{tag}^{{commit}}").decode().strip()
    RELEASE["verify_checkout"](ROOT, revision)
    version = RELEASE["workspace_version"](tomllib.loads(RELEASE["committed_file"](ROOT, revision, "Cargo.toml").decode()))
    if tag != f"v{version}":
        raise ReleaseError("tag and committed workspace version differ")
    remote = json.loads(run(["gh", "api", f"repos/{REPOSITORY}/git/ref/tags/{tag}"]).stdout)["object"]
    while remote["type"] == "tag":
        remote = json.loads(run(["gh", "api", f"repos/{REPOSITORY}/git/tags/{remote['sha']}"]).stdout)["object"]
    if remote["type"] != "commit" or remote["sha"] != revision:
        raise ReleaseError("local tag does not match the release repository's tag commit")
    release = json.loads(run([
        "gh", "release", "view", tag, "--repo", REPOSITORY,
        "--json", "tagName,isDraft,isPrerelease,url,assets",
    ]).stdout)
    if release["tagName"] != tag or release["isDraft"] or release["isPrerelease"]:
        raise ReleaseError("an existing published stable GitHub release is required; this command never creates one")
    return revision, version, release


def asset_names(version, target):
    prefix = f"cantrip-v{version}-{target}"
    return [f"{prefix}.zip", f"{prefix}.manifest.json", f"{prefix}.SHA256SUMS"]


def publish(args):
    PACKAGE["RUNTIME"]["require_native"](args.target)
    if os.environ.get("CARGO_BUILD_JOBS", "4") != "4":
        raise ReleaseError("this Mac's native build slot requires CARGO_BUILD_JOBS=4")
    os.environ["CARGO_BUILD_JOBS"] = "4"
    revision, version, release = released_source(args.tag)
    names = asset_names(version, args.target)
    if {asset["name"] for asset in release["assets"]}.intersection(names):
        raise ReleaseError("macOS assets already exist (possibly a partial upload); refusing to replace release bytes")
    output = args.output.expanduser().absolute()
    if os.path.lexists(output):
        raise ReleaseError("--output must be a new directory")
    if not args.sign_identity:
        args.sign_identity = PACKAGE["developer_identity"](args.team_id)["sha1"]
    args.source_revision = revision
    args.ad_hoc = False
    args.dev_sign_identity = None
    args.keychain = None
    args.source_runtime = False
    args.output = output
    PACKAGE["package"](args)
    manifest = json.loads((output / "manifest.json").read_text())
    if (
        manifest["signing"] != "developer-id" or manifest["source_tree_dirty"]
        or manifest["source_revision"] != revision or manifest["target"] != args.target
        or manifest["team_identifier"] != args.team_id
        or not manifest["hardened_runtime"] or manifest["notarization"]["status"] != "accepted"
        or manifest["notarization"]["stapled"] is not True
        or manifest["archive"]["name"] != names[0]
    ):
        raise ReleaseError("packaged manifest does not describe the requested production release")
    archive = output / names[0]
    if RELEASE["sha256"](archive) != manifest["archive"]["sha256"]:
        raise ReleaseError("packaged ZIP does not match its manifest")
    upload_manifest = output / names[1]
    shutil.copyfile(output / "manifest.json", upload_manifest)
    sums = output / names[2]
    sums.write_text("".join(f"{RELEASE['sha256'](path)}  {path.name}\n" for path in (archive, upload_manifest)))
    assets = [archive, upload_manifest, sums]
    RELEASE["verify_checkout"](ROOT, revision)
    run(["gh", "release", "upload", args.tag, "--repo", REPOSITORY, *assets], timeout=600)
    with tempfile.TemporaryDirectory(prefix="cantrip-mac-upload-readback-") as directory:
        command = ["gh", "release", "download", args.tag, "--repo", REPOSITORY, "--dir", directory]
        for name in names:
            command += ["--pattern", name]
        run(command, timeout=600)
        for asset in assets:
            if RELEASE["sha256"](Path(directory) / asset.name) != RELEASE["sha256"](asset):
                raise ReleaseError(f"uploaded asset readback differs: {asset.name}; inspect the release before retrying")
    return release["url"], assets


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tag", required=True)
    parser.add_argument("--target", choices=PACKAGE["TARGETS"], default={"arm64": "aarch64-apple-darwin", "x86_64": "x86_64-apple-darwin"}.get(platform.machine()))
    parser.add_argument("--sign-identity", help="optional full Developer ID Application SHA-1 if multiple local private-key identities exist; never a name")
    parser.add_argument("--team-id", required=True)
    parser.add_argument("--notary-profile", required=True)
    parser.add_argument("--output", type=Path, required=True, help="new local output directory; keep it outside the clean source worktree")
    args = parser.parse_args()
    try:
        if not args.target:
            raise ReleaseError("run on a native arm64 or Intel Mac")
        url, assets = publish(args)
    except (ReleaseError, OSError, ValueError, KeyError, RuntimeError) as error:
        parser.exit(1, f"publish-macos: {error}\n")
    print("Developer ID signed, notarized, stapled and Gatekeeper-assessed assets uploaded and downloaded bytes matched.")
    print(url)
    for asset in assets:
        print(asset.name)


if __name__ == "__main__":
    main()
