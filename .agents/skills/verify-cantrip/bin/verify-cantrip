#!/usr/bin/env python3
"""Drive Cantrip the way a Linux user does, in a disposable session.

Every Cantrip process this helper starts runs with private HOME/XDG
directories, a headless Sway compositor (its own clipboard and layer-shell
HUD), and a private PipeWire microphone: a null sink the helper plays speech
into, remapped as a real source node that the session config selects. The
operator's daemon, clipboard, configuration, keyring, and history are never
touched. Run `verify-cantrip --help` or see ../SKILL.md.
"""
import argparse
import difflib
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
import wave

SKILL = Path(__file__).resolve().parent.parent
REPO = SKILL.parent.parent.parent
JFK = REPO / "samples/jfk.wav"
JFK_TEXT = "And so my fellow Americans, ask not what your country can do for you, ask what you can do for your country."
OPERATOR_MODELS = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "cantrip/models"
REPOSITORY = "misty-step/cantrip"
SITE = "https://cantrip.mistystep.io"
SESSION_TOOLS = ("sway", "grim", "wtype", "wl-copy", "wl-paste", "tesseract", "pw-record", "pw-play", "pw-dump", "pactl")
OTHER_TOOLS = ("gh", "jq", "curl", "playwright")
# Desktop/session handles that would reach the operator's compositor, seat, or
# D-Bus (and with it the OS keyring). The session gets none of them.
DESKTOP_VARS = ("DISPLAY", "WAYLAND_DISPLAY", "SWAYSOCK", "HYPRLAND_INSTANCE_SIGNATURE", "DBUS_SESSION_BUS_ADDRESS",
                "XDG_SESSION_ID", "XDG_SEAT_PATH", "XDG_SESSION_PATH", "XDG_SEAT", "XDG_VTNR")
# Audio routing overrides (an agent sandbox may set these). Any of them can
# silently redirect pw-play/pw-record away from the private nodes.
AUDIO_VARS = ("PIPEWIRE_NODE", "PIPEWIRE_PROPS", "PIPEWIRE_DEBUG", "PULSE_PROP", "PULSE_SINK", "PULSE_SOURCE", "PULSE_SERVER")
# Safety net: never let a stream fall back to the operator's default devices.
NO_FALLBACK = "{ node.dont-fallback = true }"
XDG = {"HOME": "h", "XDG_RUNTIME_DIR": "r", "XDG_CONFIG_HOME": "c", "XDG_STATE_HOME": "s", "XDG_DATA_HOME": "d", "XDG_CACHE_HOME": "k"}
SOCKET_MAX = 107  # sun_path; sway names its IPC socket sway-ipc.<uid>.<pid>.sock in XDG_RUNTIME_DIR


class Failure(Exception):
    pass


def die(message):
    raise Failure(message)


def audio_env():
    """Environment for host-side PipeWire commands: no inherited routing, no fallback."""
    env = {k: v for k, v in os.environ.items() if k not in AUDIO_VARS}
    env["PIPEWIRE_PROPS"] = NO_FALLBACK
    return env


class Run:
    """A run directory: `session/` is scratch, `evidence/` survives `down`."""

    def __init__(self, path):
        self.root = Path(path).expanduser().resolve()
        self.session = self.root / "session"
        self.evidence = self.root / "evidence"
        self.state_file = self.root / "session.json"

    def state(self):
        if not self.state_file.exists():
            die(f"no session at {self.root}; run `verify-cantrip up --run {self.root} --binary PATH` first")
        return json.loads(self.state_file.read_text())

    def env(self, state=None):
        """The caller's environment minus desktop/audio handles, plus the session's own values."""
        state = state or self.state()
        env = {k: v for k, v in os.environ.items() if k not in DESKTOP_VARS + AUDIO_VARS}
        env.update(state["overrides"])
        return env

    def log(self, record):
        self.evidence.mkdir(parents=True, exist_ok=True)
        with (self.evidence / "transcript.jsonl").open("a") as out:
            out.write(json.dumps(record) + "\n")


def run_cmd(run, argv, env, label=None, timeout=60, check=False, quiet=False):
    """Run one command and record command/exit/stdout/stderr. A timeout is a failure, never an exit code."""
    started = time.time()
    shown = [label or Path(argv[0]).name] + [str(a) for a in argv[1:]]
    try:
        result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        if run:
            run.log({"at": round(started, 3), "argv": shown, "exit": None, "error": f"timed out after {timeout}s"})
        die(f"{' '.join(shown)} timed out after {timeout}s")
    code, out, err = result.returncode, result.stdout, result.stderr
    if run:
        run.log({"at": round(started, 3), "argv": shown, "exit": code, "stdout": out, "stderr": err[-4000:]})
    if not quiet:
        print(f"$ {' '.join(shown)}  -> exit {code}")
        if out.strip():
            print(out.rstrip())
        if err.strip():
            print("[stderr] " + err.rstrip()[-2000:].replace("\n", "\n[stderr] "))
    if check and code != 0:
        die(f"{' '.join(shown)} failed ({code})")
    return code, out, err


def until(predicate, description, timeout=30, interval=0.25):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(interval)
    die(f"timed out after {timeout}s waiting for {description}")


def start_time(pid):
    """Kernel start time of pid (field 22 of /proc/PID/stat), or None if it is gone."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    return stat.rsplit(")", 1)[1].split()[19]


def own_pid(record):
    """True only if the recorded pid is still the very process we started (pid + start time)."""
    return start_time(record["pid"]) == record["start"]


# ---------------------------------------------------------------- doctor

def cmd_doctor(args):
    ok = True

    def report(good, line):
        nonlocal ok
        ok = ok and good
        print(f"[{'ok' if good else 'FAIL'}] {line}")

    for tool in SESSION_TOOLS + OTHER_TOOLS:
        report(bool(shutil.which(tool)), f"tool {tool}" + ("" if shutil.which(tool) else " missing (see SKILL.md Launch)"))
    report(JFK.is_file(), f"public speech fixture {JFK.relative_to(REPO)}")
    load = os.getloadavg()[0]
    print(f"[{'info' if load < os.cpu_count() else 'warn'}] host load {load:.1f} on {os.cpu_count()} CPUs"
          + ("" if load < os.cpu_count() else "; audio xruns and slow pw-record stops (#164) get likelier"))
    overrides = [k for k in AUDIO_VARS if k in os.environ]
    print(f"[info] inherited audio routing vars {overrides or 'none'}; the session and its PipeWire commands drop them")
    model = OPERATOR_MODELS / "parakeet-tdt-0.6b-v3-int8"
    print(f"[{'ok' if model.is_dir() else 'info'}] reusable local model {'present' if model.is_dir() else 'absent; `up` will run `models pull` (~640 MB)'}")
    if args.binary:
        binary = Path(args.binary).resolve()
        code, out, _ = run_cmd(None, [str(binary), "--version"], os.environ, quiet=True)
        report(code == 0, f"binary {binary}: {out.strip() or 'does not run'}")
    # The operator's own install is observed read-only and never driven.
    # The operator's own daemon is never contacted (even ping writes to its log): look at its socket only.
    socket = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "cantrip/cantrip.sock"
    print(f"[info] operator daemon socket {socket}: {'present — never drive it' if socket.exists() else 'absent'}")
    try:
        code, body, _ = fetch(f"{SITE}/health.json", timeout=15)
        health = json.loads(body) if code == 200 else {}
        report(health.get("status") == "ok", f"website {SITE}/health.json HTTP {code} status {health.get('status')} revision {health.get('revision', '?')[:12]}")
    except (urllib.error.URLError, OSError, ValueError) as error:
        report(False, f"website {SITE}/health.json: {error}")
    if args.run:
        run = Run(args.run)
        state = run.state()
        env = run.env(state)
        for name, record in state["procs"].items():
            report(own_pid(record), f"session {name} pid {record['pid']} still the process `up` started")
        code, out, _ = run_cmd(None, ["pactl", "list", "short", "sources"], audio_env(), quiet=True)
        report(state["source"] in out.split(), f"private microphone source {state['source']}")
        code, out, err = run_cmd(None, [state["binary"], "ping"], env, quiet=True)
        report(code == 0, f"session daemon ping: {' '.join((out or err).split())[:120]}")
    sys.exit(0 if ok else 1)


# ---------------------------------------------------------------- install

def cmd_install(args):
    out = Path(args.out).expanduser().resolve()
    out.mkdir(parents=True, exist_ok=True)
    if (out / "prefix").exists():
        die(f"{out}/prefix already exists; use a new --out directory")
    run = Run(out)
    env = dict(os.environ)
    version = args.version
    if not version:
        code, tag, _ = run_cmd(run, ["gh", "release", "view", "--repo", REPOSITORY, "--json", "tagName", "-q", ".tagName"], env, check=True)
        version = tag.strip().removeprefix("v")
    archive = f"cantrip-v{version}-x86_64-unknown-linux-gnu.tar.gz"
    download = out / "download"
    if download.exists():
        shutil.rmtree(download)
    download.mkdir()
    run_cmd(run, ["gh", "release", "download", f"v{version}", "--repo", REPOSITORY, "--dir", str(download),
                  "--pattern", archive, "--pattern", "release.json", "--pattern", "SHA256SUMS", "--pattern", "provenance.json"], env, check=True, timeout=300)
    os.chdir(download)
    code, sums, _ = run_cmd(run, ["sha256sum", "--check", "--strict", "--ignore-missing", "SHA256SUMS"], env, check=True)
    if f"{archive}: OK" not in sums or "release.json: OK" not in sums:
        die("SHA256SUMS did not cover both the archive and release.json")
    meta = json.loads((download / "release.json").read_text())
    if not (meta["version"] == version and meta["tag"] == f"v{version}" and meta["archive"]["name"] == archive
            and re.fullmatch(r"[0-9a-f]{40}", meta["source_revision"])):
        die("release.json identity does not match the selected tag")
    for subject in ("release.json", archive):
        run_cmd(run, ["gh", "attestation", "verify", subject, "--repo", REPOSITORY, "--bundle", "provenance.json",
                      "--source-digest", meta["source_revision"], "--signer-workflow", f"{REPOSITORY}/.github/workflows/release.yml",
                      "--deny-self-hosted-runners"], env, check=True, timeout=120)
    if hashlib.sha256((download / archive).read_bytes()).hexdigest() != meta["archive"]["sha256"]:
        die("archive sha256 differs from release.json")
    run_cmd(run, ["tar", "-xzf", archive], env, check=True)
    folder = download / archive.removesuffix(".tar.gz")
    os.chdir(folder)
    run_cmd(run, ["sha256sum", "--check", "--strict", "checksums.txt"], env, check=True)
    # Install into a private prefix with private XDG dirs: the installer's
    # running-daemon refusal looks at XDG_RUNTIME_DIR, so the operator's live
    # daemon is neither seen nor disturbed.
    prefix = out / "prefix"
    iso = dict(env)
    for key, short in XDG.items():
        path = out / "install-env" / short
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        iso[key] = str(path)
    run_cmd(run, ["./install.sh", "install", "--prefix", str(prefix)], iso, check=True)
    binary = prefix / "bin/cantrip"
    code, reported, _ = run_cmd(run, [str(binary), "--version"], iso, check=True)
    if reported.strip() != f"cantrip {version}":
        die(f"installed binary reports {reported.strip()!r}, expected 'cantrip {version}'")
    digest = hashlib.sha256(binary.read_bytes()).hexdigest()
    if digest != meta["binary_sha256"]:
        die("installed binary sha256 differs from release.json binary_sha256")
    code, _, refusal = run_cmd(run, ["./install.sh", "install", "--prefix", str(prefix)], iso)
    refused = code != 0 and "already exists" in refusal
    proof = {"feature": "install", "version": version, "source_revision": meta["source_revision"],
             "binary": str(binary), "binary_sha256": digest, "attestation": "verified (release.json + archive)",
             "repeat_install_refused": refused}
    (out / "evidence").mkdir(exist_ok=True)
    (out / "evidence/install.json").write_text(json.dumps(proof, indent=2) + "\n")
    print(json.dumps(proof, indent=2))
    if not refused:
        die("a repeat install over an existing binary was not refused")


# ---------------------------------------------------------------- session

def write_config(binary, env, source, injection):
    subprocess.run([binary, "config", "init"], env=env, check=True, capture_output=True, timeout=30)
    path = Path(subprocess.run([binary, "config", "path"], env=env, check=True, capture_output=True, text=True, timeout=30).stdout.strip())
    text = path.read_text()
    text = re.sub(r'^injection = "[a-z]+"', f'injection = "{injection}"', text, count=1, flags=re.M)
    text = text.replace('# audio_source = "…"', f'audio_source = "{source}"', 1)
    text = text.replace("labels = false", "labels = true", 1)
    path.write_text(text)
    shown = subprocess.run([binary, "config", "show"], env=env, check=True, capture_output=True, text=True, timeout=30).stdout
    if f'audio_source = "{source}"' not in shown or f'injection = "{injection}"' not in shown:
        die(f"session config edits did not take; `config show` was:\n{shown}")
    return path


def unload_own_modules(state):
    """Unload only modules whose arguments name this run's private nodes (module ids are reused)."""
    code, out, _ = run_cmd(None, ["pactl", "list", "short", "modules"], audio_env(), quiet=True)
    own_args = {f"sink_name={state['sink']}", f"source_name={state['source']}"}
    mine = {line.split("\t")[0] for line in out.splitlines()
            if own_args & set(line.split("\t", 2)[-1].split())}
    result = {}
    for module in reversed(state.get("modules", [])):
        if module in mine:
            code, _, _ = run_cmd(None, ["pactl", "unload-module", module], audio_env(), quiet=True)
            result[module] = "unloaded" if code == 0 else "unload failed"
        else:
            result[module] = "not ours anymore; left alone"
    return result


def cmd_up(args):
    for tool in SESSION_TOOLS:
        if not shutil.which(tool):
            die(f"missing {tool}; run `verify-cantrip doctor`")
    run = Run(args.run)
    if run.state_file.exists():
        die(f"{run.root} already has a session; run `verify-cantrip down --run {run.root}` first")
    runtime = run.session / XDG["XDG_RUNTIME_DIR"]
    if len(str(runtime)) + len("/sway-ipc.4294967295.4194304.sock") > SOCKET_MAX:
        die(f"--run path is too long for Wayland/IPC sockets ({len(str(runtime))} chars before the socket name); "
            "use a short one such as ~/.cache/tmp/vc/<HHMMSS>")
    binary = str(Path(args.binary).resolve())
    run.session.mkdir(parents=True, exist_ok=True)
    run.evidence.mkdir(parents=True, exist_ok=True)
    sink = f"cantrip_verify_{os.getpid()}"
    real_runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    overrides = {}
    for key, short in XDG.items():
        path = run.session / short
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        overrides[key] = str(path)
    # PipeWire stays the operator's server (that is how the private nodes are
    # reachable); everything else resolves inside the run directory.
    overrides.update(PIPEWIRE_RUNTIME_DIR=real_runtime, PULSE_RUNTIME_PATH=f"{real_runtime}/pulse", PIPEWIRE_PROPS=NO_FALLBACK,
                     WLR_BACKENDS="headless", WLR_RENDERER="pixman", WLR_LIBINPUT_NO_DEVICES="1",
                     LIBGL_ALWAYS_SOFTWARE="1", XDG_SESSION_TYPE="wayland", XDG_CURRENT_DESKTOP="sway",
                     BROWSER="none", EDITOR="true", VISUAL="true", NO_COLOR="1")
    # Transparent observation shim: Cantrip finds pw-record on PATH. The shim
    # appends the daemon's exact arguments and PIPEWIRE_PROPS to a log, then
    # execs the real pw-record unchanged, so how Cantrip launches capture is
    # observable even when pw-record exits at once.
    real = shutil.which("pw-record")
    shim_dir = run.session / "bin"
    shim_dir.mkdir(parents=True, exist_ok=True)
    shim = shim_dir / "pw-record"
    shim.write_text("#!/usr/bin/env python3\nimport json, os, sys\n"
                    f"with open({str(run.session / 'pw-record.jsonl')!r}, 'a') as log:\n"
                    "    log.write(json.dumps({'argv': sys.argv[1:], 'pipewire_props': os.environ.get('PIPEWIRE_PROPS')}) + '\\n')\n"
                    f"os.execv({real!r}, [{real!r}] + sys.argv[1:])\n")
    shim.chmod(0o755)
    overrides["PATH"] = f"{shim_dir}:{os.environ.get('PATH', '')}"
    state = {"binary": binary, "sink": sink, "source": f"{sink}_mic", "overrides": overrides, "procs": {}, "modules": [],
             "started": time.time()}

    def save():
        run.state_file.write_text(json.dumps(state, indent=2))
        run.state_file.chmod(0o600)

    def launch(name, argv):
        log = (run.evidence / f"{name}.log").open("ab")
        process = subprocess.Popen(argv, env=run.env(state), stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
        state["procs"][name] = {"pid": process.pid, "start": until(lambda: start_time(process.pid), f"{name} start time", timeout=5)}
        save()
        return process

    save()
    try:
        _, module, _ = run_cmd(run, ["pactl", "load-module", "module-null-sink", f"sink_name={sink}",
                                     f"sink_properties=device.description={sink}"], audio_env(), check=True)
        state["modules"].append(module.strip())
        save()
        _, module, _ = run_cmd(run, ["pactl", "load-module", "module-remap-source", f"master={sink}.monitor",
                                     f"source_name={state['source']}", f"source_properties=device.description={state['source']}"],
                               audio_env(), check=True)
        state["modules"].append(module.strip())
        save()
        conf = run.session / "sway.conf"
        conf.write_text("output HEADLESS-1 mode 1280x900\nseat seat0 fallback true\nxwayland disable\n"
                        "default_border pixel 0\nfor_window [app_id=\".*\"] floating enable\n")
        compositor = launch("compositor", ["sway", "-c", str(conf)])
        lock = until(lambda: next(runtime.glob("wayland-*.lock"), None), "headless Wayland socket")
        overrides["WAYLAND_DISPLAY"] = lock.name.removesuffix(".lock")
        overrides["SWAYSOCK"] = str(runtime / f"sway-ipc.{os.getuid()}.{compositor.pid}.sock")
        until(lambda: Path(overrides["SWAYSOCK"]).exists(), "headless compositor IPC")
        save()
        # A virtual keyboard gives the headless seat input capabilities.
        launch("keyboard", ["wtype", "-s", "3600000"])
        env = run.env(state)
        config = write_config(binary, env, state["source"], args.injection)
        run.log({"config": str(config), "injection": args.injection, "audio_source": state["source"]})
        models = Path(env["XDG_DATA_HOME"]) / "cantrip/models"
        source = OPERATOR_MODELS / "parakeet-tdt-0.6b-v3-int8"
        if args.no_model:
            pass
        elif source.is_dir() and not args.pull_model:
            models.mkdir(parents=True, exist_ok=True)
            # Reflink copy: instant on btrfs/xfs, a real copy elsewhere. The
            # operator's model directory is only read.
            subprocess.run(["cp", "-r", "--reflink=auto", str(source), str(models)], check=True)
        else:
            run_cmd(run, [binary, "models", "pull"], env, check=True, timeout=1800)
        run_cmd(run, [binary, "models", "status"], env)
        if not args.no_daemon:
            launch("daemon", [binary, "daemon"])
            until(lambda: subprocess.run([binary, "ping"], env=env, capture_output=True).returncode == 0, "session daemon ping", timeout=60)
        print(json.dumps({"run": str(run.root), "binary": binary, "microphone": state["source"], "speaker": sink,
                          "wayland": overrides["WAYLAND_DISPLAY"], "evidence": str(run.evidence)}, indent=2))
    except BaseException:
        print("verify-cantrip: up failed; tearing down what it started", file=sys.stderr)
        teardown(run)
        raise


def stop_proc(record, timeout=20):
    if not own_pid(record):
        return "gone"
    try:
        os.kill(record["pid"], signal.SIGTERM)
    except ProcessLookupError:
        return "gone"
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not own_pid(record):
            return "exited"
        time.sleep(0.2)
    if own_pid(record):
        try:
            os.kill(record["pid"], signal.SIGKILL)
        except ProcessLookupError:
            return "exited"
        return "killed"
    return "exited"


def teardown(run):
    if not run.state_file.exists():
        return
    state = json.loads(run.state_file.read_text())
    result = {}
    for name in ("daemon", "keyboard", "compositor"):
        if name in state["procs"]:
            try:
                result[name] = stop_proc(state["procs"][name])
            except OSError as error:
                result[name] = f"stop failed: {error}"
    result["modules"] = unload_own_modules(state)
    run.log({"teardown": result})
    launches = run.session / "pw-record.jsonl"
    if launches.exists():
        shutil.copy(launches, run.evidence / "pw-record-launches.jsonl")
    shutil.rmtree(run.session, ignore_errors=True)
    run.state_file.unlink()
    print(json.dumps({"teardown": result, "evidence_kept": str(run.evidence)}, indent=2))


def cmd_down(args):
    run = Run(args.run)
    if not run.state_file.exists():
        print(f"no session at {run.root}; nothing to stop (evidence, if any, is in {run.evidence})")
        return
    teardown(run)


# ---------------------------------------------------------------- drive primitives

def cmd_cantrip(args):
    run = Run(args.run)
    state = run.state()
    argv = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
    code, out, err = run_cmd(run, [state["binary"]] + argv, run.env(state), label="cantrip", timeout=args.timeout, quiet=True)
    sys.stdout.write(out)
    sys.stderr.write(err)
    sys.exit(code)


def play_argv(run, wav):
    return ["pw-play", "--target", run.state()["sink"], str(wav)]


def speak(run, wav):
    # pw-play blocks for the clip's duration; it plays into the private sink only.
    return run_cmd(run, play_argv(run, wav), audio_env(), timeout=120)


def cmd_speak(args):
    run = Run(args.run)
    code, _, _ = speak(run, Path(args.wav or JFK).resolve())
    sys.exit(code)


def status(run):
    state = run.state()
    code, out, _ = run_cmd(run, [state["binary"], "status", "--json"], run.env(state), quiet=True)
    return json.loads(out) if code == 0 else None


def last_event(run):
    snap = status(run)
    if snap is None:
        die("session daemon did not answer status; run doctor --run")
    return snap["outcome"]["event_id"] if snap.get("outcome") else 0


def wait_settled(run, after_event, timeout=180):
    """Wait for idle with a terminal outcome newer than after_event."""
    def settled():
        snap = status(run)
        if not snap or snap["state"] != "idle" or not snap.get("outcome"):
            return None
        return snap if snap["outcome"]["event_id"] > after_event else None
    return until(settled, "an idle state with a new terminal outcome", timeout=timeout, interval=0.5)


def cmd_wait(args):
    run = Run(args.run)
    snap = wait_settled(run, args.after_event, args.timeout)
    run.log({"settled": snap})
    print(json.dumps(snap["outcome"], indent=2))


def clipboard(run):
    result = subprocess.run(["wl-paste", "--no-newline"], env=run.env(), capture_output=True, timeout=10)
    return result.stdout.decode(errors="replace") if result.returncode == 0 else None


def set_clipboard(run, text):
    subprocess.run(["wl-copy", text], env=run.env(), check=True, timeout=10)


def cmd_clipboard(args):
    run = Run(args.run)
    if args.set is not None:
        set_clipboard(run, args.set)
        run.log({"clipboard_set_chars": len(args.set)})
    text = clipboard(run)
    run.log({"clipboard_chars": None if text is None else len(text)})
    print(text if text is not None else "(clipboard empty)")


def recorder_pids(run):
    """PIDs of pw-record processes the session daemon is running."""
    daemon = run.state()["procs"].get("daemon", {}).get("pid")
    found = []
    for stat in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = stat.read_text().rsplit(")", 1)
            comm = fields[0].split("(", 1)[1]
            ppid = int(fields[1].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        if ppid == daemon and comm == "pw-record":
            found.append(stat.parent.name)
    return found


def capture_links(run):
    """Names of the PipeWire nodes feeding the session daemon's pw-record child (empty if not recording)."""
    children = recorder_pids(run)
    if not children:
        return None
    dump = json.loads(subprocess.run(["pw-dump"], env=audio_env(), capture_output=True, text=True, timeout=20).stdout)
    clients = {obj["id"] for obj in dump if obj.get("type") == "PipeWire:Interface:Client" and obj.get("info")
               and str(obj["info"]["props"].get("application.process.id")) in children}
    recorders = {obj["id"] for obj in dump if obj.get("type") == "PipeWire:Interface:Node" and obj.get("info")
                 and obj["info"]["props"].get("client.id") in clients}
    return feeders(dump, recorders)


def feeders(dump, node_ids):
    names = {obj["id"]: obj["info"]["props"].get("node.name") for obj in dump
             if obj.get("type") == "PipeWire:Interface:Node" and obj.get("info")}
    return sorted({names.get(obj["info"]["output-node-id"]) for obj in dump
                   if obj.get("type") == "PipeWire:Interface:Link" and obj.get("info")
                   and obj["info"].get("input-node-id") in node_ids})


def remap_links(run):
    """Names of the nodes feeding the private _mic's own capture stream (must be only the private sink)."""
    state = run.state()
    dump = json.loads(subprocess.run(["pw-dump"], env=audio_env(), capture_output=True, text=True, timeout=20).stdout)
    inputs = {obj["id"] for obj in dump if obj.get("type") == "PipeWire:Interface:Node" and obj.get("info")
              and obj["info"]["props"].get("node.name") == f"input.{state['source']}"}
    return feeders(dump, inputs)


def cmd_links(args):
    run = Run(args.run)
    links, remap = capture_links(run), remap_links(run)
    run.log({"capture_links": links, "remap_links": remap})
    print(json.dumps({"recording_from": links, "private_microphone": run.state()["source"],
                      "private_microphone_fed_by": remap, "private_speaker": run.state()["sink"]}))


def shot(run, name):
    path = run.evidence / f"{name}.png"
    subprocess.run(["grim", str(path)], env=run.env(), check=True, capture_output=True, timeout=15)
    text = subprocess.run(["tesseract", str(path), "stdout"], capture_output=True, text=True, timeout=60).stdout
    (run.evidence / f"{name}.ocr.txt").write_text(text)
    return path, " ".join(text.split())


def cmd_shot(args):
    run = Run(args.run)
    path, text = shot(run, args.name)
    print(f"{path}\nOCR: {text[:400]}")


def open_window(run, window, name, doctor=False, settle=4, expect=()):
    """Open a native window (settings/actions) in the headless compositor, screenshot it, close it."""
    state = run.state()
    log = (run.evidence / f"{name}.log").open("ab")
    process = subprocess.Popen([state["binary"], window] + (["--doctor"] if doctor else []), env=run.env(state),
                               stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    try:
        time.sleep(settle)
        path, text = shot(run, name)
        # OCR of a single frame can come back empty; re-shoot until the window has
        # finished connecting and shows the expected text, or 20 s pass.
        def ready(text):
            return "Connecting" not in text and all(re.search(pattern, text, re.I) for pattern in expect)
        deadline = time.monotonic() + 20
        while not ready(text) and process.poll() is None and time.monotonic() < deadline:
            time.sleep(1)
            path, text = shot(run, name)
        alive = process.poll() is None
        run.log({"window": window, "screenshot": path.name, "alive": alive, "ocr_excerpt": text[:300]})
        if not alive:
            die(f"{window} exited ({process.returncode}) before the screenshot; see evidence/{name}.log")
        return path, text
    finally:
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def cmd_window(args):
    if args.doctor and args.window != "actions":
        die("--doctor exists only for `actions`")
    run = Run(args.run)
    path, text = open_window(run, args.window, args.name or f"window-{args.window}", args.doctor, args.settle)
    print(f"{path}\nOCR: {text[:600]}")


# ---------------------------------------------------------------- journeys

def words(text):
    return re.findall(r"[a-z']+", text.lower())


def jfk_coverage(text):
    """Share of the JFK sentence's words recognized in order (0..1)."""
    expected = words(JFK_TEXT)
    matcher = difflib.SequenceMatcher(None, words(text), expected, autojunk=False)
    return sum(block.size for block in matcher.get_matching_blocks()) / len(expected)


def jfk_match(text, run=None, where=""):
    """Recognition varies by a word or two per take: require >= 80% of the sentence's words, in order,
    and the closing "for your country" so a lost second clause cannot pass.
    Only fixture-derived text is ever compared, so it is safe to log."""
    coverage = jfk_coverage(text)
    if run:
        run.log({"jfk_coverage": round(coverage, 3), "where": where, "text": text[:300]})
    return coverage >= 0.8 and "for your country" in " ".join(words(text))


def check(condition, message, results, known_issue=None):
    item = {"check": message, "ok": bool(condition)}
    if known_issue and not condition:
        item["known_issue"] = known_issue
    results.append(item)
    tag = "ok" if condition else ("KNOWN" if known_issue else "FAIL")
    print(f"[{tag}] {message}" + (f" ({known_issue})" if known_issue and not condition else ""))
    return condition


def cantrip(run, *argv, timeout=60):
    state = run.state()
    return run_cmd(run, [state["binary"], *argv], run.env(state), label="cantrip", timeout=timeout)


def act(run, results, label, *argv, timeout=180):
    """Run a daemon command and wait for its outcome; a rejected command fails the check without waiting."""
    before = last_event(run)
    code, _, err = cantrip(run, *argv)
    check(code == 0, f"{label} accepted (exit {code}{': ' + err.strip()[:120] if code else ''})", results)
    if code != 0:
        die(f"{label} was rejected; later steps depend on it")
    return wait_settled(run, before, timeout)


def history_dir(run):
    return Path(run.env()["XDG_STATE_HOME"]) / "cantrip/transcripts"


def record_take(run, wav, results, name=None):
    """start → (speak) → stop through the CLI; returns the settled snapshot."""
    before = last_event(run)
    cantrip(run, "start")
    until(lambda: (status(run) or {}).get("state") == "recording", "recording state", timeout=20)
    time.sleep(1.0)  # let pw-record link to the source, as a speaker pauses after pressing start
    voice = subprocess.Popen(play_argv(run, wav), env=audio_env(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        time.sleep(3)
        links = capture_links(run)
        run.log({"capture_links": links})
        check(links == [run.state()["source"]], f"daemon records only the private microphone (links: {links})", results)
        remap = remap_links(run)
        run.log({"remap_links": remap})
        check(remap == [run.state()["sink"]], f"private microphone is fed only by the private speaker sink (links: {remap})", results)
        if name:
            shot(run, name)
        voice.wait(timeout=60)
    finally:
        if voice.poll() is None:
            voice.kill()
            voice.wait()
    run.log({"argv": play_argv(run, wav), "exit": voice.returncode})
    time.sleep(0.5)
    return before


def journey_dictate(run, results):
    before = record_take(run, JFK, results, "dictate-1-recording")
    cantrip(run, "stop")
    snap = wait_settled(run, before)
    shot(run, "dictate-2-settled")
    outcome = snap["outcome"]
    check(outcome["completeness"] == "complete", f"take completeness is complete (got {outcome['completeness']})", results)
    check(outcome["delivery"] == "copied", f"delivery is copied (got {outcome['delivery']})", results)
    text = clipboard(run) or ""
    check(jfk_match(text, run, "clipboard"), f"real clipboard holds the spoken JFK sentence ({len(text)} chars)", results)
    cantrip(run, "status")
    take = outcome["artifacts"]["take_id"]
    archive = history_dir(run) / f"{take}.json"
    check(archive.is_file() and archive.stat().st_mode & 0o777 == 0o600, "transcript archived owner-only in history", results)
    code, out, _ = cantrip(run, "recordings", "--json")
    rows = [row for row in json.loads(out) if row["id"] == take] if code == 0 else []
    check(rows and rows[0]["text_available"] and rows[0]["audio_available"], "recordings lists the take with text and audio", results)
    return take


def journey_recover(run, results, take=None):
    if take is None:
        take = journey_dictate(run, results)
    placeholder = "verify-cantrip placeholder"
    # Copy by exact id after the clipboard was overwritten.
    set_clipboard(run, placeholder)
    act(run, results, "copy ID", "copy", take)
    check(jfk_match(clipboard(run) or "", run, "clipboard"), "copy ID restored the saved transcript to the clipboard", results)
    # Cancel mid-recording: nothing delivered, audio retained.
    set_clipboard(run, placeholder)
    before = record_take(run, JFK, results)
    cantrip(run, "cancel")
    snap = wait_settled(run, before)
    shot(run, "recover-1-cancelled")
    cancelled = snap["outcome"]
    check(cancelled["completeness"] == "cancelled", f"cancel settles as cancelled (got {cancelled['completeness']})", results)
    check(clipboard(run) == placeholder, "cancel delivered nothing to the clipboard", results)
    cancelled_id = cancelled["artifacts"]["take_id"]
    audio = history_dir(run) / f"{cancelled_id}.wav"
    check(audio.is_file() and audio.stat().st_size > 44, "cancelled take keeps its audio on disk", results)
    # Local recovery of the cancelled take, copied rather than typed.
    snap = act(run, results, "recover --local --clipboard", "recover", "--id", cancelled_id, "--local", "--clipboard")
    shot(run, "recover-2-recovered")
    check(snap["outcome"]["completeness"] == "complete" and snap["outcome"]["delivery"] == "copied",
          f"recover --local --clipboard completes and copies (got {snap['outcome']['completeness']}/{snap['outcome']['delivery']})", results)
    check(jfk_match(clipboard(run) or "", run, "clipboard"), "recovered transcript is on the clipboard", results)
    # Forget requires confirmation and removes audio only.
    code, _, err = cantrip(run, "forget", cancelled_id)
    check(code != 0 and "--yes" in err and audio.is_file(), "forget without --yes is refused and keeps the audio", results)
    archive = history_dir(run) / f"{cancelled_id}.json"
    text_before = json.loads(archive.read_text()).get("raw_transcript")
    act(run, results, "forget --yes", "forget", cancelled_id, "--yes")
    check(not audio.exists(), "confirmed Forget deleted the take's audio file", results)
    code, out, _ = cantrip(run, "recordings", "--json")
    rows = [row for row in json.loads(out) if row["id"] == cancelled_id] if code == 0 else []
    check(rows and rows[0]["audio_available"] is False, "recordings shows the forgotten take without audio", results)
    check(archive.is_file() and json.loads(archive.read_text()).get("raw_transcript") == text_before and text_before,
          "complete archived text remains unchanged after Forget", results)


def journey_breaks(run, results):
    state = run.state()
    env = run.env(state)
    config = Path(subprocess.run([state["binary"], "config", "path"], env=env, capture_output=True, text=True, timeout=30).stdout.strip())
    original = config.read_text()
    try:
        # Silence: an empty take is reported, not invented, and its audio is kept.
        silence = run.session / "silence.wav"
        with wave.open(str(silence), "wb") as out:
            out.setnchannels(1)
            out.setsampwidth(2)
            out.setframerate(16000)
            out.writeframes(b"\0\0" * 16000 * 3)
        before = record_take(run, silence, results)
        cantrip(run, "stop")
        snap = wait_settled(run, before)
        shot(run, "breaks-1-silence")
        take = snap["outcome"]["artifacts"]["take_id"]
        check(snap["outcome"]["completeness"] == "empty" and (history_dir(run) / f"{take}.wav").is_file(),
              f"silence settles empty with audio kept (got {snap['outcome']['completeness']})", results)
        # Second daemon in the same runtime dir is refused; the first keeps running.
        code, _, err = run_cmd(run, [state["binary"], "daemon"], env, label="cantrip", timeout=20)
        check(code != 0 and "already running" in err, "a second daemon for the same runtime is refused as already running", results)
        check(subprocess.run([state["binary"], "ping"], env=env, capture_output=True, timeout=15).returncode == 0, "original daemon still answers ping", results)
        # Missing model: transcribe refuses without an implicit download.
        bare = dict(env)
        empty = run.session / "no-model-data"
        empty.mkdir(exist_ok=True, mode=0o700)
        bare["XDG_DATA_HOME"] = str(empty)
        code, out, err = run_cmd(run, [state["binary"], "transcribe", "--local", str(JFK)], bare, label="cantrip", timeout=60)
        check(code != 0 and not out.strip() and not any(empty.rglob("*")), "missing model refuses transcription and downloads nothing", results)
        # The inherited no-fallback remains a safety net even when testing old binaries.
        config.write_text(original.replace(f'audio_source = "{state["source"]}"', 'audio_source = "cantrip_verify_absent_source"'))
        cantrip(run, "reload")
        saved = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in history_dir(run).glob("*") if p.is_file()}
        code, out, _ = cantrip(run, "doctor")
        check(code == 0 and "capture: blocked" in out and "configured microphone `cantrip_verify_absent_source` not found" in out,
              "doctor reports the missing configured microphone", results)
        before = last_event(run)
        launches = run.session / "pw-record.jsonl"
        seen = launches.read_text() if launches.exists() else ""
        code, out, err = cantrip(run, "start")
        check(code != 0 and "configured microphone `cantrip_verify_absent_source` not found" in out + err,
              "start refuses the missing microphone with its ID and an actionable error", results)
        if code == 0:  # Safely settle old binaries; no fallback is allowed by the session.
            cantrip(run, "stop")
            wait_settled(run, before)
        check((launches.read_text() if launches.exists() else "") == seen,
              "missing source is refused before pw-record launches", results)
        check(capture_links(run) in (None, []), "missing microphone never records another device", results)
        after = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in history_dir(run).glob("*") if p.is_file()}
        check(after == saved, "missing-source refusal leaves accepted takes unchanged and creates no audio", results)
        shot(run, "breaks-2-absent-mic")
        config.write_text(original)
        cantrip(run, "reload")
        # Automatic delivery on an unverified (non-Hyprland) desktop must not send keys.
        config.write_text(re.sub(r'^injection = "[a-z]+"', 'injection = "auto"', original, count=1, flags=re.M))
        cantrip(run, "reload")
        placeholder = "verify-cantrip placeholder"
        set_clipboard(run, placeholder)
        before = record_take(run, JFK, results)
        cantrip(run, "stop")
        snap = wait_settled(run, before)
        shot(run, "breaks-3-auto-unverified-desktop")
        delivery = snap["outcome"]["delivery"]
        board = clipboard(run) or ""
        consistent = (delivery == "copied" and jfk_match(board)) or (delivery == "deferred" and board == placeholder)
        check(consistent, f"auto on an unverified desktop copies or defers, and the clipboard agrees (got {delivery})", results)
    finally:
        config.write_text(original)
        try:
            cantrip(run, "reload")
        except Exception as error:  # noqa: BLE001 - never mask the original failure
            run.log({"restore_reload_failed": f"{type(error).__name__}: {error}"})
    # Daemon down: client commands fail clearly instead of hanging.
    down_env = dict(env)
    down_env["XDG_RUNTIME_DIR"] = str(run.session / "nd")
    Path(down_env["XDG_RUNTIME_DIR"]).mkdir(exist_ok=True, mode=0o700)
    started = time.monotonic()
    code, _, err = run_cmd(run, [state["binary"], "ping"], down_env, label="cantrip", timeout=30)
    check(code != 0 and time.monotonic() - started < 15 and "cantrip daemon" in err, "ping with no daemon fails fast with a start hint", results)


def journey_windows(run, results):
    for window, expected in (("settings", (r"Past transcripts", r"\b[1-9]\d* saved transcripts?\b")),
                             ("actions", (r"Recordings", r"Recover locally"))):
        _, text = open_window(run, window, f"windows-{window}", expect=expected)
        missing = [pattern for pattern in expected if not re.search(pattern, text, re.I)]
        check(not missing, f"{window} window shows {expected} (missing {missing})", results)
    hud = run.evidence / "windows-hud-copied.png"
    code, _, _ = cantrip(run, "hud", "--screenshot", str(hud), "--state", "copied")
    check(code == 0 and hud.is_file() and hud.stat().st_size > 1000, "HUD renders the copied state", results)


def journey_transcribe(run, results):
    code, out, _ = cantrip(run, "transcribe", "--local", str(JFK), timeout=180)
    check(code == 0 and jfk_match(out), "transcribe --local prints the JFK sentence on stdout", results)
    saved = [json.loads(p.read_text()) for p in history_dir(run).glob("*.json")]
    check(any(item.get("source") == "transcribe" and jfk_match(item.get("raw_transcript") or "") for item in saved),
          "one-shot transcript saved to private history", results)
    code, out, _ = cantrip(run, "doctor")
    check(code == 0 and "capture: ready" in out, "doctor exits 0 reporting the private capture source ready", results)


JOURNEYS = {"transcribe": journey_transcribe, "dictate": journey_dictate, "recover": journey_recover,
            "breaks": journey_breaks, "windows": journey_windows}


def cmd_journey(args):
    run = Run(args.run)
    state = run.state()
    results = []
    names = list(JOURNEYS) if args.name == "all" else [args.name]
    for name in names:
        print(f"== journey {name}")
        try:
            JOURNEYS[name](run, results)
        except Exception as error:  # noqa: BLE001 - record why and continue to the report
            print(f"[FAIL] {name} aborted: {type(error).__name__}: {error}")
            results.append({"check": f"{name} journey ran to completion", "ok": False, "error": f"{type(error).__name__}: {error}"})
    failed = [r for r in results if not r["ok"] and "known_issue" not in r]
    known = [r for r in results if "known_issue" in r]
    report = {"journeys": names, "binary": state["binary"],
              "binary_version": subprocess.run([state["binary"], "--version"], capture_output=True, text=True).stdout.strip(),
              "binary_sha256": hashlib.sha256(Path(state["binary"]).read_bytes()).hexdigest(),
              "isolation": "headless sway (pixman), private HOME/XDG/runtime/clipboard, private PipeWire null sink + remapped source "
                           "as the microphone, inherited audio routing dropped, node.dont-fallback set, capture links checked",
              "fixture": "samples/jfk.wav (public speech)", "results": results,
              "passed": not failed, "known_failures": known}
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    (run.evidence / f"journey-{args.name}-{stamp}.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps({"passed": report["passed"], "failed": [r["check"] for r in failed],
                      "known_failures": [f"{r['check']} -> {r['known_issue']}" for r in known]}, indent=2))
    sys.exit(0 if report["passed"] else 1)


# ---------------------------------------------------------------- website

def fetch(url, timeout=20):
    request = urllib.request.Request(url, headers={"User-Agent": "verify-cantrip", "Cache-Control": "no-cache"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, response.read().decode(errors="replace"), response.geturl()
    except urllib.error.HTTPError as error:
        return error.code, error.read().decode(errors="replace"), url


def gh(*args):
    result = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=60)
    if result.returncode != 0 or not result.stdout.strip():
        die(f"gh {' '.join(args)} failed: {result.stderr.strip()[:300]}")
    return result.stdout.strip()


def cmd_site(args):
    run = Run(args.out)
    run.evidence.mkdir(parents=True, exist_ok=True)
    base = args.url.rstrip("/")
    results = []
    master = gh("api", f"repos/{REPOSITORY}/commits/master", "-q", ".sha")
    tag = gh("release", "view", "--repo", REPOSITORY, "--json", "tagName", "-q", ".tagName")
    status_code, body, _ = fetch(f"{base}/health.json")
    health = json.loads(body) if status_code == 200 else {}
    run.log({"url": f"{base}/health.json", "status": status_code, "body": health})
    check(health.get("status") == "ok" and health.get("environment") == "production", "health.json reports ok/production", results)
    deployed = health.get("revision", "")
    if not re.fullmatch(r"[0-9a-f]{40}", deployed):
        relation = "missing"
    elif deployed == master:
        relation = "identical"
    else:
        # "behind": master is ahead of the deployed revision, i.e. deploy pending.
        relation = gh("api", f"repos/{REPOSITORY}/compare/{master}...{deployed}", "-q", ".status")
    check(relation in ("identical", "behind"), f"deployed revision {deployed[:12]} is master {master[:12]} or an ancestor ({relation})", results)
    run.log({"master": master, "deployed": deployed, "relation": relation, "release": tag})
    pages = {"/": ["Speak.", "Download for Linux x86-64", tag], "/docs/install": ["Install Cantrip"],
             "/docs/use": ["First dictation"], "/changelog": [tag], "/releases": [tag], "/evals": ["speech"]}
    for path, needles in pages.items():
        status_code, body, final = fetch(base + path)
        missing = [n for n in needles if n.lower() not in body.lower()]
        run.log({"url": base + path, "status": status_code, "final_url": final, "bytes": len(body), "missing": missing})
        check(status_code == 200 and not missing, f"{path} renders (HTTP {status_code}) with {needles}", results)
    status_code, home, _ = fetch(base + "/")
    downloads = sorted(set(re.findall(r'href="(https://github\.com/misty-step/cantrip/releases/download/[^"]+)"', home)))
    check(any(f"/{tag}/" in link for link in downloads), f"home page links the {tag} release download", results)
    for link in downloads[:3]:
        request = urllib.request.Request(link, method="HEAD", headers={"User-Agent": "verify-cantrip"})
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                code = response.status
        except urllib.error.HTTPError as error:
            code = error.code
        check(code == 200, f"download link {link} resolves (HTTP {code})", results)
    internal = sorted(set(re.findall(r'href="(/[^"#?]*)"', home)))
    broken = [link for link in internal if fetch(base + link)[0] != 200]
    run.log({"internal_links": internal, "broken": broken})
    check(internal and not broken, f"all {len(internal)} internal links on / return 200 (broken: {broken})", results)
    status_code, _, _ = fetch(base + "/definitely-not-a-page-verify-cantrip")
    check(status_code == 404, f"unknown route returns 404 (got {status_code})", results)
    for name, size in (("site-desktop", "1440,900"), ("site-mobile", "390,844")):
        target = run.evidence / f"{name}.png"
        code, _, _ = run_cmd(run, ["playwright", "screenshot", f"--viewport-size={size}", "--full-page", "--wait-for-timeout=1500", base + "/", str(target)],
                             os.environ, timeout=120)
        check(code == 0 and target.is_file() and target.stat().st_size > 10000, f"{name} screenshot at {size}", results)
    report = {"feature": "website", "url": base, "deployed_revision": deployed, "master": master, "release": tag,
              "results": results, "passed": all(r["ok"] for r in results)}
    (run.evidence / "site.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps({"passed": report["passed"], "failed": [r["check"] for r in results if not r["ok"]]}, indent=2))
    sys.exit(0 if report["passed"] else 1)


# ---------------------------------------------------------------- cli

def main():
    parser = argparse.ArgumentParser(prog="verify-cantrip", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("doctor", help="read-only: tools, binary, site, and (with --run) session health")
    p.add_argument("--run")
    p.add_argument("--binary")
    p.set_defaults(func=cmd_doctor)
    p = sub.add_parser("install", help="download, verify, and install the published Linux release into a private prefix")
    p.add_argument("--out", required=True)
    p.add_argument("--version", help="X.Y.Z without v; default latest release")
    p.set_defaults(func=cmd_install)
    p = sub.add_parser("up", help="start headless sway, a private microphone, and an isolated daemon")
    p.add_argument("--run", required=True, help="new short path, e.g. ~/.cache/tmp/vc/$(date +%%m%%d%%H%%M%%S)")
    p.add_argument("--binary", required=True)
    p.add_argument("--injection", default="clipboard", choices=["clipboard", "auto", "paste", "type"])
    p.add_argument("--pull-model", action="store_true", help="download the model instead of reflink-copying the operator's")
    p.add_argument("--no-model", action="store_true")
    p.add_argument("--no-daemon", action="store_true")
    p.set_defaults(func=cmd_up)
    p = sub.add_parser("down", help="stop what `up` started and unload its PipeWire modules; evidence/ is kept")
    p.add_argument("--run", required=True)
    p.set_defaults(func=cmd_down)
    p = sub.add_parser("cantrip", help="run the session's cantrip binary with the session env: cantrip --run DIR -- status --json")
    p.add_argument("--run", required=True)
    p.add_argument("--timeout", type=int, default=120)
    p.add_argument("argv", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_cantrip)
    p = sub.add_parser("speak", help="play a WAV into the private microphone (default samples/jfk.wav)")
    p.add_argument("--run", required=True)
    p.add_argument("wav", nargs="?")
    p.set_defaults(func=cmd_speak)
    p = sub.add_parser("links", help="show which PipeWire nodes the session daemon is recording from right now")
    p.add_argument("--run", required=True)
    p.set_defaults(func=cmd_links)
    p = sub.add_parser("wait", help="wait for idle with a terminal outcome newer than --after-event")
    p.add_argument("--run", required=True)
    p.add_argument("--after-event", type=int, required=True)
    p.add_argument("--timeout", type=int, default=180)
    p.set_defaults(func=cmd_wait)
    p = sub.add_parser("clipboard", help="print the session clipboard (wl-paste); --set TEXT overwrites it first")
    p.add_argument("--run", required=True)
    p.add_argument("--set", metavar="TEXT")
    p.set_defaults(func=cmd_clipboard)
    p = sub.add_parser("shot", help="screenshot the headless output (+ OCR text) into evidence/NAME.png")
    p.add_argument("--run", required=True)
    p.add_argument("name")
    p.set_defaults(func=cmd_shot)
    p = sub.add_parser("window", help="open settings or actions in the session, screenshot, close")
    p.add_argument("--run", required=True)
    p.add_argument("window", choices=["settings", "actions"])
    p.add_argument("--name")
    p.add_argument("--doctor", action="store_true", help="actions --doctor")
    p.add_argument("--settle", type=float, default=4)
    p.set_defaults(func=cmd_window)
    p = sub.add_parser("journey", help="scripted proof: transcribe | dictate | recover | breaks | windows | all")
    p.add_argument("--run", required=True)
    p.add_argument("name", choices=list(JOURNEYS) + ["all"])
    p.set_defaults(func=cmd_journey)
    p = sub.add_parser("site", help="drive the public website read-only; screenshots at desktop and mobile width")
    p.add_argument("--out", required=True)
    p.add_argument("--url", default=SITE)
    p.set_defaults(func=cmd_site)
    args = parser.parse_args()
    try:
        args.func(args)
    except Failure as error:
        print(f"verify-cantrip: {error}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
