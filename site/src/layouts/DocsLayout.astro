---
import type { MarkdownHeading } from 'astro';
import SiteLayout from './SiteLayout.astro';
import { docs, repositoryUrl } from '../lib/docs.mjs';

interface Props {
  doc: (typeof docs)[number];
  headings: MarkdownHeading[];
}

const { doc, headings } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const position = docs.findIndex((candidate) => candidate.slug === doc.slug);
const previous = docs[position - 1];
const next = docs[position + 1];
---
<SiteLayout title={`${doc.title} — Cantrip documentation`} description={doc.description} section="docs">
  <div class="docs-shell shell">
    <aside class="docs-sidebar">
      <nav class="docs-nav" aria-label="Documentation">
        <p class="nav-heading">Documentation</p>
        <ul>
          {docs.map((item) => (
            <li><a href={`/docs/${item.slug}`} aria-current={item.slug === doc.slug ? 'page' : undefined}>{item.title}</a></li>
          ))}
        </ul>
      </nav>
      {sections.length > 0 && (
        <details class="page-contents" open>
          <summary>On this page</summary>
          <nav aria-label="On this page">
            <ul>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
          </nav>
        </details>
      )}
    </aside>
    <div class="docs-main">
      <p class="source-note">Repository documentation <a href={`${repositoryUrl}/blob/master/docs/${doc.file}`}>View Markdown source</a></p>
      <article class="prose"><slot /></article>
      <nav class="docs-pagination" aria-label="Continue reading">
        {previous ? <a href={`/docs/${previous.slug}`}><span>Previous</span>{previous.title}</a> : <span />}
        {next && <a href={`/docs/${next.slug}`}><span>Next</span>{next.title}</a>}
      </nav>
    </div>
  </div>
</SiteLayout>
