---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found — Cantrip" description="This Cantrip page does not exist. Find the installation guide, documentation, or published releases." noindex>
  <div class="shell not-found">
    <p class="error-code">404</p>
    <h1>This page isn’t here.</h1>
    <p>The link may be out of date. Start with the installation guide, browse published releases, or return to the homepage.</p>
    <div class="actions">
      <a class="button button-primary" href="/docs/install">Open the installation guide</a>
      <a class="button button-secondary" href="/releases">Browse releases</a>
    </div>
    <p><a href="/">Return to Cantrip</a></p>
  </div>
</SiteLayout>
