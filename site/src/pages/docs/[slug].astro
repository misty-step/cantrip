---
import { getCollection, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docs } from '../../lib/docs.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('documentation');
  return docs.map((doc) => {
    const entry = entries.find((candidate) => candidate.id === doc.slug);
    if (!entry) throw new Error(`Missing canonical document: docs/${doc.file}`);
    return { params: { slug: doc.slug }, props: { doc, entry } };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { doc, entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout doc={doc} headings={headings}><Content /></DocsLayout>
