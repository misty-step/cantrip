# Example user unit for one live session; start and stop it from a key.
# No [Install]: it runs only when started, and stopping it closes the session gracefully.
[Unit]
Description=Cantrip T3 live voice session
After=graphical-session.target pipewire.service

[Service]
ExecStart=%h/.local/bin/pass-env run -e OPENAI_API_KEY=openai/api-key -e T3_MCP_TOKEN=t3/home-mcp -- %h/.local/bin/uv run --script %h/.local/bin/cantrip-t3-live run
KillSignal=SIGTERM
TimeoutStopSec=60
