# Example user unit for hands-free turn-taking; start and stop it from a key.
# No [Install]: it listens only while started, and ends itself after idle_minutes.
[Unit]
Description=Cantrip T3 hands-free conversation
Wants=cantrip-t3.service
After=graphical-session.target pipewire.service cantrip-t3.service

[Service]
ExecStart=%h/.local/bin/pass-env run -e T3_MCP_TOKEN=t3/home-mcp -e CANTRIP_T3_SPEECH_KEY=openrouter/voice -- %h/.local/bin/cantrip-t3-converse run
KillSignal=SIGTERM
TimeoutStopSec=10
