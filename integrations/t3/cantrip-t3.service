# Example user unit; replace the launcher and secret entries with your own.
[Unit]
Description=Cantrip T3 voice: speak agent replies
After=graphical-session.target pipewire.service

[Service]
ExecStart=%h/.local/bin/pass-env run -e T3_MCP_TOKEN=t3/home-mcp -e CANTRIP_T3_SPEECH_KEY=openrouter/speech -- %h/.local/bin/cantrip-t3 collect
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
