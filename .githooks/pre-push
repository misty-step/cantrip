#!/usr/bin/env bash
# Heavier gates on every push: full test suite + authoritative secret scan of
# the working tree (trufflehog). Install with: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "── pre-push: cargo test"
cargo test

echo "── pre-push: secret scan (trufflehog, working tree)"
if command -v trufflehog >/dev/null 2>&1; then
    # --fail makes trufflehog exit non-zero when anything is found; without it
    # the scan always exits 0 and this gate would prove nothing.
    trufflehog filesystem . --exclude-paths .trufflehog-exclude --fail >/dev/null 2>&1 || {
        echo "✗ working tree contains a secret (trufflehog). Refusing to push."
        exit 1
    }
else
    echo "⚠ trufflehog not installed; skipping scan. Install: https://github.com/trufflesecurity/trufflehog"
fi
